<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smith Panel | JobBar</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="icon" href="/icons/jobbar.png">
    <style>
        .admin-page { min-height: 100vh; padding: 32px 20px; color: #fff; }
        .admin-page h1 { text-align: center; margin: 0 0 24px; }
        .admin-table-wrap { max-width: 1100px; margin: 0 auto; overflow-x: auto; }
        .admin-table { width: 100%; border-collapse: collapse; background: rgba(0, 0, 0, 0.28); }
        .admin-table th, .admin-table td { padding: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.14); text-align: left; vertical-align: middle; }
        .admin-table th { color: #f4b4c8; }
        .admin-filter { max-width: 1100px; margin: 0 auto 16px; display: flex; gap: 8px; }
        .admin-filter select, .admin-filter input { padding: 10px; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 4px; }
        .admin-filter select { min-width: 140px; }
        .admin-filter input { flex: 1; min-width: 0; }
        .empty { text-align: center; padding: 24px; }
        @media (max-width: 700px) { .admin-page { padding: 20px 10px; } .admin-table th, .admin-table td { padding: 8px; } .admin-filter { flex-direction: column; } }
    </style>
</head>
<body>
    <%- include("banner.ejs") %>
    <main class="admin-page">
        <h1>Smith Panel</h1>
        <div class="admin-filter">
            <select id="admin-filter-field" aria-label="Filter field">
                <option value="owner-id">ID</option>
                <option value="owner">Owner</option>
            </select>
            <input id="admin-filter-input" type="search" placeholder="Search owner Formbar ID" aria-label="Search companies">
        </div>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr><th>Company</th><th>ID</th><th>Owner</th><th></th></tr>
                </thead>
                <tbody>
                    <% if (companies.length) { %>
                        <% companies.forEach(company => { %>
                            <tr class="company-row" data-owner-id="<%= company.owner_id ?? '' %>" data-owner="<%= company.owner_username || '' %>">
                                <td><%= company.name %></td>
                                <td><div style="display: flex; align-items: center; gap: 8px;">
                                    <img src="/icons/fid.png" alt="User" width="18" height="18" style="filter: invert(1);">
                                    <%= company.owner_id ?? 'none' %>
                                </div></td>
                                <td><div style="display: flex; align-items: center; gap: 8px;">
                                    <%= company.owner_username || 'Guest' %>
                                </div></td>
                                <td>
                                    <%- include("companyActions.ejs", { company: company }) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td class="empty" colspan="4">No companies found.</td></tr>
                    <% } %>
                    <tr id="no-filter-results" hidden><td class="empty" colspan="4">No matching companies found.</td></tr>
                </tbody>
            </table>
        </div>
    </main>
    <div id="transfer-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); align-items:center; justify-content:center; z-index:10000;">
        <div style="background:#fff; color:black; padding:18px; border-radius:8px; width:360px; max-width:92%; box-shadow:0 10px 30px rgba(0,0,0,0.4);">
            <h3 style="margin-top:0;">Transfer Company Ownership</h3>
            <p id="transfer-company-name" style="margin:6px 0 12px 0; font-weight:600;"></p>
            <form id="transfer-form" action="/companies/transfer-owner" method="POST" onsubmit="return confirm('Are you sure you want to transfer ownership of this company?');">
                <input type="hidden" name="companyId" id="transfer-company-id" value="">
                <input type="hidden" name="returnTo" value="/admin">
                <label for="newOwnerFb">New Owner Formbar ID:</label>
                <input id="newOwnerFb" name="newOwnerFb" type="text" required style="width:100%; padding:8px; margin:8px 0 12px 0;">
                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" id="transfer-cancel" style="padding:8px 12px; background:rgb(180, 67, 84); color:white; border-radius:12px; border:none; cursor:pointer;">Cancel</button>
                    <button type="submit" style="padding:8px 12px; background:#2a7; color:#fff; border:none; border-radius:12px; cursor:pointer;">Transfer</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const filterField = document.getElementById('admin-filter-field');
        const filterInput = document.getElementById('admin-filter-input');
        const companyRows = document.querySelectorAll('.company-row');
        const noFilterResults = document.getElementById('no-filter-results');

        function filterCompanies() {
            const field = filterField.value;
            const search = filterInput.value.trim().toLowerCase();
            let visibleRows = 0;

            companyRows.forEach(row => {
                const value = (field === 'owner' ? row.dataset.owner : row.dataset.ownerId).toLowerCase();
                const matches = !search || value.includes(search);
                row.hidden = !matches;
                if (matches) visibleRows += 1;
            });

            noFilterResults.hidden = visibleRows !== 0 || companyRows.length === 0;
        }

        filterField.addEventListener('change', () => {
            filterInput.placeholder = filterField.value === 'owner' ? 'Search owner name' : 'Search owner Formbar ID';
            filterCompanies();
        });
        filterInput.addEventListener('input', filterCompanies);
    </script>
</body>
</html>
