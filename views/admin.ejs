<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smith Panel | JobBar</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="icon" href="/icons/jobbar.png">
    <style>
        .admin-page { min-height: 100vh; padding: 32px 20px; color: #fff; }
        .admin-page h1 { text-align: center; margin: 0 0 24px; }
        .admin-table-wrap { max-width: 1100px; margin: 0 auto; overflow-x: auto; }
        .admin-table { width: 100%; border-collapse: collapse; background: rgba(0, 0, 0, 0.28); table-layout: fixed; }
        .admin-table th, .admin-table td { padding: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.14); text-align: left; vertical-align: middle; overflow-wrap: anywhere; }
        .admin-table th { color: #f4b4c8; }
        .admin-filter { max-width: 1100px; margin: 0 auto 16px; }
        .admin-filter input { width: 100%; padding: 10px; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 4px; }
        .empty { text-align: center; padding: 24px; }
        .manager-section { max-width: 1100px; margin: 0 auto 28px; }
        .manager-section h2,
        .companies-section h2 { margin: 0 0 10px; }
        .section-toggle {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.28);
            color: #fff;
            font: inherit;
            font-weight: 700;
            text-align: left;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .section-toggle:hover { background: rgba(255, 255, 255, 0.08); }
        .section-toggle::after { content: '▸'; font-size: 1rem; }
        .section-toggle[aria-expanded="true"]::after { content: '▾'; }
        .section-content { margin-top: 12px; }
        .section-content[hidden] { display: none; }
        .manager-filter { margin-bottom: 12px; }
        .companies-section { max-width: 1100px; margin: 0 auto 28px; }
        @media (max-width: 700px) {
            .admin-page { padding: 20px 10px; }
            .admin-table th, .admin-table td { padding: 8px 6px; }
            .admin-table { font-size: 0.88rem; }
            .admin-table button { max-width: 100%; }
        }
        @media (max-width: 480px) {
            .admin-table th, .admin-table td { padding: 6px 4px; }
            .admin-table { font-size: 0.78rem; }
        }
    </style>
</head>
<body>
    <%- include("banner.ejs") %>
    <main class="admin-page">
        <h1>Smith Panel</h1>
        <div class="manager-section">
            <button type="button" class="section-toggle" aria-expanded="false">
                <span>Managers</span>
            </button>
            <div class="section-content" hidden>
                <div class="admin-filter manager-filter">
                    <input id="manager-filter-input" type="search" placeholder="Search username or Formbar ID" aria-label="Search users">
                </div>
                <div class="admin-table-wrap" style="margin:0;">
                    <table class="admin-table">
                        <thead><tr><th>User</th><th>Formbar ID</th><th>Manager Status</th></tr></thead>
                        <tbody>
                            <% users.forEach(managedUser => { %>
                                <tr class="manager-row" data-username="<%= managedUser.username || '' %>" data-user-id="<%= managedUser.fb_id ?? '' %>">
                                    <td><%= managedUser.username || 'Guest' %></td>
                                    <td><%= managedUser.fb_id %></td>
                                    <td>
                                        <form action="/admin/users/manager" method="POST" style="display:inline;">
                                            <input type="hidden" name="fbId" value="<%= managedUser.fb_id %>">
                                            <input type="hidden" name="isManager" value="<%= managedUser.is_manager ? 'false' : 'true' %>">
                                            <button type="submit" style="padding:8px 12px; border:none; border-radius:12px; cursor:pointer; background:<%= managedUser.is_manager ? '#a44' : '#2a7' %>; color:#fff;">
                                                <%= managedUser.is_manager ? 'Remove Manager' : 'Make Manager' %>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (!users.length) { %>
                                <tr><td class="empty" colspan="3">No users found.</td></tr>
                            <% } %>
                            <tr id="no-manager-results" hidden><td class="empty" colspan="3">No matching users found.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="companies-section">
            <button type="button" class="section-toggle" aria-expanded="false">
                <span>Companies</span>
            </button>
            <div class="section-content" hidden>
                <div class="admin-filter">
                    <input id="admin-filter-input" type="search" placeholder="Search owner username or Formbar ID" aria-label="Search companies">
                </div>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr><th>Company</th><th>ID</th><th>Owner</th><th></th></tr>
                        </thead>
                        <tbody>
                            <% if (companies.length) { %>
                                <% companies.forEach(company => { %>
                                    <tr class="company-row" data-owner-id="<%= company.owner_id ?? '' %>" data-owner="<%= company.owner_username || '' %>">
                                        <td><%= company.name %></td>
                                        <td><div style="display: flex; align-items: center; gap: 8px;">
                                            <img src="/icons/fid.png" alt="User" width="18" height="18" style="filter: invert(1);">
                                            <%= company.owner_id ?? 'none' %>
                                        </div></td>
                                        <td><div style="display: flex; align-items: center; gap: 8px;">
                                            <%= company.owner_username || 'Guest' %>
                                        </div></td>
                                        <td>
                                            <%- include("companyActions.ejs", { company: company }) %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td class="empty" colspan="4">No companies found.</td></tr>
                            <% } %>
                            <tr id="no-filter-results" hidden><td class="empty" colspan="4">No matching companies found.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <div id="transfer-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); align-items:center; justify-content:center; z-index:10000;">
        <div style="background:#fff; color:black; padding:18px; border-radius:8px; width:360px; max-width:92%; box-shadow:0 10px 30px rgba(0,0,0,0.4);">
            <h3 style="margin-top:0;">Transfer Company Ownership</h3>
            <p id="transfer-company-name" style="margin:6px 0 12px 0; font-weight:600;"></p>
            <form id="transfer-form" action="/companies/transfer-owner" method="POST" onsubmit="return confirm('Are you sure you want to transfer ownership of this company?');">
                <input type="hidden" name="companyId" id="transfer-company-id" value="">
                <input type="hidden" name="returnTo" value="/admin">
                <label for="newOwnerFb">New Owner Formbar ID:</label>
                <input id="newOwnerFb" name="newOwnerFb" type="text" required style="width:100%; padding:8px; margin:8px 0 12px 0;">
                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" id="transfer-cancel" style="padding:8px 12px; background:rgb(180, 67, 84); color:white; border-radius:12px; border:none; cursor:pointer;">Cancel</button>
                    <button type="submit" style="padding:8px 12px; background:#2a7; color:#fff; border:none; border-radius:12px; cursor:pointer;">Transfer</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const managerFilterInput = document.getElementById('manager-filter-input');
        const companyFilterInput = document.getElementById('admin-filter-input');
        const managerRows = document.querySelectorAll('.manager-row');
        const companyRows = document.querySelectorAll('.company-row');
        const noManagerResults = document.getElementById('no-manager-results');
        const noFilterResults = document.getElementById('no-filter-results');
        const managerToggle = document.querySelector('.manager-section .section-toggle');
        const companyToggle = document.querySelector('.companies-section .section-toggle');
        const managerContent = document.querySelector('.manager-section .section-content');
        const companyContent = document.querySelector('.companies-section .section-content');

        function filterManagers() {
            const search = managerFilterInput.value.trim().toLowerCase();
            let visibleRows = 0;

            managerRows.forEach(row => {
                const username = row.dataset.username.toLowerCase();
                const userId = row.dataset.userId.toLowerCase();
                const matches = !search || username.includes(search) || userId.includes(search);
                row.hidden = !matches;
                if (matches) visibleRows += 1;
            });

            noManagerResults.hidden = visibleRows !== 0 || managerRows.length === 0;
        }

        function filterCompanies() {
            const search = companyFilterInput.value.trim().toLowerCase();
            let visibleRows = 0;

            companyRows.forEach(row => {
                const ownerUsername = row.dataset.owner.toLowerCase();
                const ownerId = row.dataset.ownerId.toLowerCase();
                const matches = !search || ownerUsername.includes(search) || ownerId.includes(search);
                row.hidden = !matches;
                if (matches) visibleRows += 1;
            });

            noFilterResults.hidden = visibleRows !== 0 || companyRows.length === 0;
        }

        managerFilterInput.addEventListener('input', filterManagers);
        companyFilterInput.addEventListener('input', filterCompanies);

        managerToggle.addEventListener('click', () => {
            const expanded = managerToggle.getAttribute('aria-expanded') === 'true';
            managerToggle.setAttribute('aria-expanded', !expanded);
            managerContent.hidden = expanded;
        });

        companyToggle.addEventListener('click', () => {
            const expanded = companyToggle.getAttribute('aria-expanded') === 'true';
            companyToggle.setAttribute('aria-expanded', !expanded);
            companyContent.hidden = expanded;
        });
    </script>
</body>
</html>
